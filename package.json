{
  "name": "atow",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build  --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "cleanup": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./cleanup.ps1",
    "copy": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./copy.ps1",
    "ghpage": "ng deploy --base-href=./",
    "publish": "run-p cleanup build && run-p copy && run-p ghpage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/router": "^21.2.24",
    "angular-cli-ghpages": "^1.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "~21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-edge-launcher": "^0.4.2",
    "karma-edgium-launcher": "^4.0.0-0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-spec-reporter": "^0.0.36",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.17": true
  }
}
