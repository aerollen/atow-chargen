{
  "name": "atow",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build  --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --coverage",
    "cleanup": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./cleanup.ps1",
    "copy": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./copy.ps1",
    "ghpage": "ng deploy --base-href=/atow-chargen/",
    "publish": "run-p cleanup build && run-p copy && run-p ghpage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "angular-cli-ghpages": "^3.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.17": true
  }
}
